rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function currentUserData() {
      return userDoc(request.auth.uid).data;
    }

    function isActiveUserData(userData) {
      return userData.status == 'active';
    }

    function firebaseTokenClaims() {
      return request.auth.token.get('firebase', {});
    }

    function signedInWithTotp() {
      return signedIn()
        && firebaseTokenClaims().get('sign_in_second_factor', '') == 'totp'
        && firebaseTokenClaims().get('second_factor_identifier', '') is string
        && firebaseTokenClaims().get('second_factor_identifier', '').size() > 0;
    }

    function isActiveTotpUser() {
      return signedInWithTotp() && isActiveUserData(currentUserData());
    }

    function isSuperAdmin() {
      return isActiveTotpUser()
        && (
          currentUserData().role == 'super-admin'
          || currentUserData().get('isSuperAdmin', false) == true
          || currentUserData().get('isAdmin', false) == true
          || currentUserData().role == 'admin'
        );
    }

    function isSirapId(value) {
      return value in [
        'orinoquia',
        'eje-cafetero'
      ];
    }

    function validSirapIdList(value) {
      return value is list
        && value.size() <= 6
        && value.toSet().hasOnly([
          'orinoquia',
          'eje-cafetero'
        ]);
    }

    function sirapIdsOrEmpty(data, field) {
      return field in data && data[field] is list ? data[field] : [];
    }

    function administersSirap(sirapId) {
      return isActiveTotpUser()
        && (
          isSuperAdmin()
          || (
            currentUserData().administeredSirapIds is list
            && sirapId in currentUserData().administeredSirapIds
          )
        );
    }

    function isSirapAdministrator() {
      return isActiveTotpUser()
        && currentUserData().administeredSirapIds is list
        && currentUserData().administeredSirapIds.size() > 0;
    }

    function canReadActiveUserForSirapAdmin() {
      return isSirapAdministrator() && resource.data.status == 'active';
    }

    function hasManifestStyleAccess() {
      return isSuperAdmin();
    }

    function isStringOrNull(value) {
      return value == null || value is string;
    }

    function isOptionalTimestamp(data, field) {
      return !(field in data) || data[field] is timestamp;
    }

    function isOptionalString(data, field) {
      return !(field in data) || isStringOrNull(data[field]);
    }

    function currentSirapSet(ids) {
      return ids.toSet().intersection(['orinoquia', 'eje-cafetero'].toSet());
    }

    function roleMatchesScopes(data) {
      let allowed = currentSirapSet(sirapIdsOrEmpty(data, 'allowedSirapIds'));
      let administered = currentSirapSet(sirapIdsOrEmpty(data, 'administeredSirapIds'));
      return data.role == 'super-admin'
        || (data.role == 'user' && allowed.size() == 0 && administered.size() == 0)
        || (data.role == 'sirap-user' && allowed.size() > 0 && administered.size() == 0)
        || (
          data.role == 'sirap-admin'
          && administered.size() > 0
          && administered.difference(allowed).size() == 0
        );
    }

    function tierMatchesRole(data) {
      return (data.role == 'super-admin' && data.tier == 3)
        || (data.role != 'super-admin' && data.tier == 2);
    }

    function resourceIsSuperAdmin() {
      return resource.data.role == 'super-admin'
        || resource.data.role == 'admin'
        || resource.data.get('isSuperAdmin', false) == true
        || resource.data.get('isAdmin', false) == true;
    }

    function optionalAdminFlagIsFalse(data, field) {
      return !(field in data) || data[field] == false;
    }

    function userRecordFields() {
      return [
        'uid',
        'email',
        'displayName',
        'status',
        'role',
        'tier',
        'isAdmin',
        'isSuperAdmin',
        'allowedSirapIds',
        'administeredSirapIds',
        'createdAt',
        'updatedAt',
        'updatedBy'
      ];
    }

    function validUserRecord(uid) {
      return request.resource.data.keys().hasOnly(userRecordFields())
        && isOptionalString(request.resource.data, 'uid')
        && (!('uid' in request.resource.data) || request.resource.data.uid == uid)
        && isOptionalString(request.resource.data, 'email')
        && isOptionalString(request.resource.data, 'displayName')
        && request.resource.data.status in ['active', 'denied']
        && request.resource.data.role in ['user', 'sirap-user', 'sirap-admin', 'super-admin']
        && roleMatchesScopes(request.resource.data)
        && tierMatchesRole(request.resource.data)
        && optionalAdminFlagIsFalse(request.resource.data, 'isAdmin')
        && optionalAdminFlagIsFalse(request.resource.data, 'isSuperAdmin')
        && (
          !('allowedSirapIds' in request.resource.data)
          || validSirapIdList(request.resource.data.allowedSirapIds)
        )
        && (
          !('administeredSirapIds' in request.resource.data)
          || validSirapIdList(request.resource.data.administeredSirapIds)
        )
        && isOptionalTimestamp(request.resource.data, 'createdAt')
        && request.resource.data.updatedAt == request.time
        && isOptionalString(request.resource.data, 'updatedBy');
    }

    function validSelfUserCreate(uid) {
      return isSelf(uid)
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'status',
          'role',
          'tier',
          'allowedSirapIds',
          'administeredSirapIds',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.status == 'active'
        && request.resource.data.role == 'user'
        && request.resource.data.tier == 2
        && request.resource.data.allowedSirapIds is list
        && request.resource.data.allowedSirapIds.size() == 0
        && request.resource.data.administeredSirapIds is list
        && request.resource.data.administeredSirapIds.size() == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validSelfDirectoryCreate(uid) {
      return isSelf(uid)
        && validDirectoryRecord(uid)
        && request.resource.data.email == request.auth.token.email
        && exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.status == 'active';
    }

    function validDirectoryRecord(uid) {
      return request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'status', 'updatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.status == 'active'
        && request.resource.data.updatedAt == request.time;
    }

    // Existing allowedSirapIds must already be current-region ids. A regional
    // admin therefore cannot strip retired ids or grant a SIRAP they do not
    // administer.
    function validSirapAdminUserUpdate() {
      return isSirapAdministrator()
        && resource.data.status == 'active'
        && !resourceIsSuperAdmin()
        && request.resource.data.role != 'super-admin'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'allowedSirapIds',
          'role',
          'tier',
          'updatedAt',
          'updatedBy'
        ])
        && roleMatchesScopes(request.resource.data)
        && tierMatchesRole(request.resource.data)
        && validSirapIdList(request.resource.data.allowedSirapIds)
        && validSirapIdList(sirapIdsOrEmpty(resource.data, 'allowedSirapIds'))
        && request.resource.data.allowedSirapIds
          .toSet()
          .difference(sirapIdsOrEmpty(resource.data, 'allowedSirapIds').toSet())
          .hasOnly(currentUserData().administeredSirapIds)
        && sirapIdsOrEmpty(resource.data, 'allowedSirapIds')
          .toSet()
          .difference(request.resource.data.allowedSirapIds.toSet())
          .hasOnly(currentUserData().administeredSirapIds)
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }

    // Super-admin SIRAP decisions replace allowedSirapIds with a current-region
    // list. Retired ids already stored on the user do not have to pass
    // validSirapIdList first. Role, tier, and admin flags stay unchanged.
    function validSuperAdminSirapAccessUpdate() {
      return isSuperAdmin()
        && resource.data.status == 'active'
        && (
          (resourceIsSuperAdmin() && request.resource.data.role == 'super-admin')
          || (!resourceIsSuperAdmin() && request.resource.data.role != 'super-admin')
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'allowedSirapIds',
          'role',
          'tier',
          'updatedAt',
          'updatedBy'
        ])
        && roleMatchesScopes(request.resource.data)
        && tierMatchesRole(request.resource.data)
        && validSirapIdList(request.resource.data.allowedSirapIds)
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }

    function sirapAccessRequestFields() {
      return [
        'uid',
        'email',
        'displayName',
        'sirapId',
        'status',
        'reason',
        'requestedAt',
        'updatedAt',
        'decidedAt',
        'decidedBy'
      ];
    }

    function validOwnSirapAccessRequest(uid) {
      return request.resource.data.keys().hasOnly(sirapAccessRequestFields())
        && uid == request.auth.uid
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && isSirapId(request.resource.data.sirapId)
        && request.resource.data.status == 'pending'
        && isOptionalString(request.resource.data, 'reason')
        && request.resource.data.requestedAt == request.time
        && request.resource.data.updatedAt == request.time
        && !('decidedAt' in request.resource.data)
        && !('decidedBy' in request.resource.data);
    }

    function validOwnSirapRerequest() {
      return signedInWithTotp()
        && resource.data.uid == request.auth.uid
        && resource.data.status in ['approved', 'denied']
        && (
          resource.data.status == 'denied'
          || !(
            resource.data.sirapId
            in sirapIdsOrEmpty(currentUserData(), 'allowedSirapIds')
          )
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'reason',
          'requestedAt',
          'updatedAt',
          'decidedAt',
          'decidedBy'
        ])
        && validOwnSirapAccessRequest(request.auth.uid);
    }

    function validSirapDecision() {
      return administersSirap(resource.data.sirapId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'decidedAt',
          'decidedBy',
          'updatedAt'
        ])
        && (
          (
            resource.data.status == 'pending'
            && request.resource.data.status in ['approved', 'denied']
          )
          || (
            resource.data.status == 'approved'
            && request.resource.data.status == 'denied'
          )
        )
        && request.resource.data.decidedAt == request.time
        && request.resource.data.decidedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }

    function manifestStyleRequestFields() {
      return [
        'editorName',
        'sourceManifestUrl',
        'baseManifestVersion',
        'baseManifestGeneratedAt',
        'diffSummary',
        'styleChanges',
        'status',
        'createdByUid',
        'createdByEmail',
        'createdByDisplayName',
        'createdAt',
        'updatedAt'
      ];
    }

    function validManifestStyleRequestCreate() {
      return request.resource.data.keys().hasOnly(manifestStyleRequestFields())
        && request.resource.data.editorName is string
        && request.resource.data.sourceManifestUrl is string
        && isStringOrNull(request.resource.data.baseManifestVersion)
        && isStringOrNull(request.resource.data.baseManifestGeneratedAt)
        && request.resource.data.diffSummary is map
        && request.resource.data.styleChanges is map
        && request.resource.data.status == 'pending'
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdByEmail == request.auth.token.email
        && isStringOrNull(request.resource.data.createdByDisplayName)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validManifestStyleRequestAdminUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'reviewedAt',
          'reviewedBy',
          'publishedAt',
          'publishedBy',
          'rejectedAt',
          'rejectedBy',
          'appliedAt',
          'publishedManifestUrl',
          'appliedManifestVersion',
          'appliedManifestGeneratedAt',
          'updatedAt'
        ])
        && request.resource.data.status in ['pending', 'published', 'rejected']
        && request.resource.data.updatedAt == request.time;
    }

    // Legacy account-approval documents stay stored. Clients cannot read or write them.
    match /accessRequests/{uid} {
      allow read, write: if false;
    }

    match /users/{uid} {
      allow get: if isSelf(uid)
        || isSuperAdmin()
        || canReadActiveUserForSirapAdmin();
      allow list: if isSuperAdmin()
        || canReadActiveUserForSirapAdmin();
      // A signed-in person may create only their own default account. Super
      // admins may still create or replace a full user record.
      allow create: if validSelfUserCreate(uid) || (isSuperAdmin() && validUserRecord(uid));
      allow update: if (isSuperAdmin() && validUserRecord(uid))
        || validSuperAdminSirapAccessUpdate()
        || validSirapAdminUserUpdate();
      allow delete: if false;

      match /savedSolutionScenarios/{scenarioId} {
        allow read: if isSelf(uid) && signedInWithTotp();
        allow create, update: if isSelf(uid)
          && signedInWithTotp()
          && request.resource.data.keys().hasOnly([
            'id',
            'solutionId',
            'label',
            'solutionName',
            'updatedAt'
          ])
          && request.resource.data.id == scenarioId
          && request.resource.data.solutionId is string
          && request.resource.data.label is string
          && request.resource.data.label.size() > 0
          && request.resource.data.label.size() <= 80
          && request.resource.data.solutionName is string
          && request.resource.data.updatedAt is string;
        allow delete: if isSelf(uid) && signedInWithTotp();
      }
    }

    match /userDirectory/{uid} {
      allow get: if isSelf(uid) || isSuperAdmin() || isSirapAdministrator();
      allow list: if isSuperAdmin() || isSirapAdministrator();
      allow create: if validSelfDirectoryCreate(uid) || (isSuperAdmin() && validDirectoryRecord(uid));
      allow update: if false;
      allow delete: if false;
    }

    match /sirapAccessRequests/{requestId} {
      allow get: if (signedIn() && resource.data.uid == request.auth.uid)
        || administersSirap(resource.data.sirapId);
      allow list: if signedIn()
        && (
          resource.data.uid == request.auth.uid
          || administersSirap(resource.data.sirapId)
        );
      allow create: if signedInWithTotp()
        && validOwnSirapAccessRequest(request.resource.data.uid)
        && requestId == request.auth.uid + '_' + request.resource.data.sirapId;
      allow update: if validOwnSirapRerequest() || validSirapDecision();
      allow delete: if false;
    }

    match /manifestStyleRequests/{requestId} {
      allow create: if hasManifestStyleAccess() && validManifestStyleRequestCreate();
      allow get, list: if isSuperAdmin();
      allow update: if isSuperAdmin() && validManifestStyleRequestAdminUpdate();
      allow delete: if false;
    }

    match /mail/{mailId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
