{
  "name": "eco-plan",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "yarn check:dependencies && node ./scripts/manifest/sync-local-preview-manifest.mjs && node ./scripts/manifest/validate-local-preview-manifest.mjs && ng serve --proxy-config proxy.conf.json",
    "sync:local-preview-manifest": "node ./scripts/manifest/sync-local-preview-manifest.mjs",
    "sync:local-preview-manifest:force": "node ./scripts/manifest/sync-local-preview-manifest.mjs --force",
    "download:layer-manifest": "yarn sync:local-preview-manifest:force",
    "build": "ng build",
    "build:production": "ng build --configuration production",
    "build:prod": "node ./scripts/config/write-production-environment.mjs && ng build",
    "build:test": "METRICS_API_BASE_URL=https://api.decision-making-support-tool.xyz PRIVATE_FILE_PROXY_PATH= CATALOG_RELEASE_INDEX_BLOB_URL=https://storage.googleapis.com/pnn-priorizando-la-naturaleza-public/catalog-releases/3.7.1-test-site-stage-b/catalog-release-index.json node ./scripts/config/write-production-environment.mjs && ng build && node ./scripts/config/write-build-info.mjs",
    "build:vercel": "node ./scripts/config/write-production-environment.mjs && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "yarn test:unit:fast",
    "test:unit:fast": "ng test --watch=false --exclude='src/app/features/left-sidebar/map-layers-panel/map-layers-panel.browser.spec.ts'",
    "test:browser:map-layers": "ng test --configuration browser --watch=false --include='src/app/features/left-sidebar/map-layers-panel/map-layers-panel.browser.spec.ts'",
    "lint": "ng lint",
    "check:dependencies": "node ./scripts/dev/check-angular-cli.mjs",
    "test:manifest-preview": "node --test ./scripts/manifest/*.spec.mjs",
    "test:security-headers": "node --test ./scripts/security-headers.spec.mjs",
    "test:secrets-probe": "node --test ./scripts/secrets-probe.spec.mjs",
    "test:firestore-rules": "node ./scripts/run-firestore-rules-tests.mjs",
    "reset:totp": "node ./scripts/reset-totp-mfa.mjs",
    "backfill:user-directory": "node ./scripts/backfill-user-directory.mjs",
    "test:auth:totp:live": "node ./scripts/live-totp-enroll.mjs",
    "test:auth:totp:offline": "node --test ./scripts/live-totp-enroll.spec.mjs",
    "format": "prettier --write \"src/**/*.{ts,html,scss,css,json,md}\"",
    "prepare": "node ./scripts/install-git-hooks.mjs"
  },
  "private": true,
  "packageManager": "yarn@4.18.0",
  "dependencies": {
    "@angular/animations": "^21.2.1",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@arcgis/core": "^5.0.9",
    "@arcgis/map-components": "^5.0.9",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "@vercel/blob": "^2.3.3",
    "chart.js": "^4.5.1",
    "chartjs-plugin-datalabels": "^2.2.0",
    "firebase": "^12.13.0",
    "firebase-admin": "^13.9.0",
    "geotiff": "^3.0.5",
    "ng2-charts": "^10.0.0",
    "ngx-color-picker": "^20.1.1",
    "qr": "^0.7.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^25.6.2",
    "@vitest/browser-playwright": "4.1.11",
    "angular-eslint": "21.2.0",
    "eslint": "^9.39.2",
    "firebase-tools": "^15.30.0",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "lint-staged": "^16.3.2",
    "playwright": "1.57.0",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.50.1",
    "vitest": "^4.1.11"
  },
  "resolutions": {
    "vite": "7.3.6",
    "websocket-driver": "0.7.5"
  },
  "lint-staged": {
    "*.{ts,html}": [
      "eslint --fix --max-warnings=0"
    ],
    "*.{ts,html,scss,css,json,md}": [
      "prettier --write"
    ]
  }
}
