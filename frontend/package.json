{
  "name": "eco-plan",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run sync:solutions && npm run sync:boundaries && ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "build:production": "ng build --configuration production",
    "build:vercel": "node ./scripts/config/write-production-environment.mjs && npm run sync:solutions && npm run sync:boundaries && npm run validate:deploy-assets && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "npm run test:unit:fast",
    "test:unit:fast": "ng test --watch=false --exclude='src/app/features/left-sidebar/map-layers-panel/map-layers-panel.browser.spec.ts'",
    "test:browser:map-layers": "ng test --configuration browser --watch=false --include='src/app/features/left-sidebar/map-layers-panel/map-layers-panel.browser.spec.ts'",
    "lint": "ng lint",
    "sync:solutions": "node ./scripts/data-deploy/sync-solutions.mjs",
    "sync:boundaries": "node ./scripts/data-deploy/sync-boundaries.mjs",
    "validate:deploy-assets": "node ./scripts/data-deploy/validate-deploy-assets.mjs",
    "generate:species-manifest": "node ./layer-manifest/generate-species-manifest.mjs",
    "upload:species-tifs": "node ./scripts/data-deploy/upload-species-tifs-to-blob.mjs",
    "upload:species-tifs:manifest": "npm run upload:species-tifs && npm run generate:species-manifest",
    "publish:ecosystem-classification-summary": "node ./scripts/data-deploy/ecosystems/publish-classification-summary.mjs",
    "upload:solutions-cogs": "node ./scripts/data-deploy/upload-solutions-cogs-to-blob.mjs",
    "publish:solution-cog-manifest": "node ./scripts/data-deploy/publish-solution-cog-manifest.mjs",
    "generate:layer-manifest": "node ./layer-manifest/generate-manifest.mjs --register-solution-prefix solutions/marine/ && node ./layer-manifest/sync-latest-manifest.mjs",
    "sync:latest-layer-manifest": "node ./layer-manifest/sync-latest-manifest.mjs",
    "validate:layer-manifest": "node ./layer-manifest/validate-manifest.mjs",
    "validate:layer-manifest:example": "node ./layer-manifest/validate-manifest.mjs ./layer-manifest/manifest.example.json",
    "test:layer-manifest": "node --test ./layer-manifest/*.spec.mjs ./layer-manifest/lib/*.spec.mjs",
    "check:layer-manifest": "npm run test:layer-manifest && npm run validate:layer-manifest:example",
    "publish:layer-manifest": "node ./layer-manifest/publish-manifest.mjs",
    "publish:styled-manifest": "node ./layer-manifest/publish-styled-manifest.mjs --publish",
    "rollback:layer-manifest": "node ./layer-manifest/rollback-manifest.mjs",
    "format": "prettier --write \"src/**/*.{ts,html,scss,css,json,md}\"",
    "prepare": "cd .. && husky .husky"
  },
  "private": true,
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "@angular/animations": "^21.2.1",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@arcgis/core": "^5.0.9",
    "@arcgis/map-components": "^5.0.9",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "@vercel/blob": "^2.3.3",
    "chart.js": "^4.5.1",
    "chartjs-plugin-datalabels": "^2.2.0",
    "firebase": "^12.13.0",
    "firebase-admin": "^13.9.0",
    "geotiff": "^3.0.5",
    "ng2-charts": "^10.0.0",
    "ngx-color-picker": "^20.1.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^25.6.2",
    "@vitest/browser-playwright": "4.0.18",
    "angular-eslint": "21.2.0",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "lint-staged": "^16.3.2",
    "playwright": "1.57.0",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.50.1",
    "vitest": "^4.0.8"
  },
  "lint-staged": {
    "*.{ts,html}": [
      "eslint --fix --max-warnings=0"
    ],
    "*.{ts,html,scss,css,json,md}": [
      "prettier --write"
    ]
  }
}
