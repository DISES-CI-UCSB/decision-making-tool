{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decision-making-tool.local/schemas/blob-layer-manifest.schema.json",
  "title": "DISES Runtime Layer Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "generatedAt", "publicBlobHost", "sourceCsv", "categories", "layers"],
  "properties": {
    "version": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "publicBlobHost": {
      "type": "string",
      "format": "uri"
    },
    "sourceCsv": {
      "type": "string"
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/category"
      }
    },
    "layers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/layer"
      }
    }
  },
  "$defs": {
    "nullableString": {
      "type": ["string", "null"]
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "spanishLabel", "layerIds"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
        },
        "spanishLabel": {
          "type": "string"
        },
        "englishLabel": {
          "$ref": "#/$defs/nullableString"
        },
        "layerIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "spanishLabel",
        "description",
        "tooltip",
        "dataRole",
        "sidebarCategoryId",
        "roleInMetricCalculation",
        "metadataUrl",
        "compressedDataForLiveMetricsUrl",
        "precomputedMetricUrls",
        "rendering"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
        },
        "spanishLabel": {
          "type": "string"
        },
        "englishLabel": {
          "$ref": "#/$defs/nullableString"
        },
        "description": {
          "type": "string"
        },
        "tooltip": {
          "$ref": "#/$defs/nullableString"
        },
        "dataRole": {
          "type": "string",
          "enum": [
            "feature_layer",
            "manifest_for_species_layers",
            "species_layer",
            "cost_layer",
            "include_layer",
            "solution_layer",
            "administrative_boundary",
            "reference_layer"
          ]
        },
        "sidebarCategoryId": {
          "type": "string"
        },
        "roleInMetricCalculation": {
          "type": "string",
          "enum": [
            "none",
            "data_used_for_live_metric_calculation",
            "boundary_used_for_precomputed_metric_lookup",
            "data_used_for_live_metric_calculation_and_precomputed_metric_lookup"
          ]
        },
        "displayUrl": {
          "$ref": "#/$defs/nullableString"
        },
        "displayCollectionUrl": {
          "$ref": "#/$defs/nullableString"
        },
        "speciesManifestUrl": {
          "$ref": "#/$defs/nullableString"
        },
        "metadataUrl": {
          "$ref": "#/$defs/nullableString"
        },
        "compressedDataForLiveMetricsUrl": {
          "$ref": "#/$defs/nullableString"
        },
        "precomputedMetricUrls": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "rendering": {
          "$ref": "#/$defs/rendering"
        }
      },
      "classColor": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value", "color"],
        "properties": {
          "value": {
            "type": "number"
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "label": {
            "$ref": "#/$defs/nullableString"
          }
        }
      },
      "rendering": {
        "type": "object",
        "additionalProperties": false,
        "required": ["valueType", "renderMode"],
        "properties": {
          "valueType": {
            "type": "string",
            "enum": ["binary", "categorical", "continuous"]
          },
          "renderMode": {
            "type": "string",
            "enum": ["mask", "gradient", "categorical"]
          },
          "noDataValue": {
            "type": ["number", "null"]
          },
          "selectedValue": {
            "type": ["number", "null"]
          },
          "selectedColor": {
            "type": ["string", "null"],
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "minValue": {
            "type": ["number", "null"]
          },
          "maxValue": {
            "type": ["number", "null"]
          },
          "startColor": {
            "type": ["string", "null"],
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "endColor": {
            "type": ["string", "null"],
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "classColors": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/classColor"
            }
          }
        }
      },
      "oneOf": [
        {
          "required": ["displayUrl"]
        },
        {
          "required": ["displayCollectionUrl"]
        }
      ]
    }
  }
}
