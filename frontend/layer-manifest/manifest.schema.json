{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decision-making-tool.local/schemas/blob-layer-manifest.schema.json",
  "title": "DISES Blob Layer Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "publicBlobHost", "categories", "layers"],
  "properties": {
    "version": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requiredLayersCsv": {
          "type": "string"
        },
        "layersInUseCsv": {
          "type": "string"
        },
        "blobInventoryGeneratedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "publicBlobHost": {
      "type": "string",
      "format": "uri"
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/category"
      }
    },
    "layers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/layer"
      }
    }
  },
  "$defs": {
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "sidebarGroupId": {
          "type": "string"
        }
      }
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "category", "visibility", "assets", "provenance"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z0-9]+(?:_[A-Z0-9]+)*$"
        },
        "displayName": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "layerGroup": {
          "type": "string"
        },
        "layerSubtype": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "visibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sidebar"],
          "properties": {
            "sidebar": {
              "type": "boolean"
            },
            "defaultVisible": {
              "type": "boolean"
            },
            "selectableInFinder": {
              "type": "boolean"
            }
          }
        },
        "assets": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "display": {
              "$ref": "#/$defs/asset"
            },
            "metric": {
              "$ref": "#/$defs/asset"
            },
            "source": {
              "$ref": "#/$defs/asset"
            }
          },
          "anyOf": [
            {
              "required": ["display"]
            },
            {
              "required": ["metric"]
            },
            {
              "required": ["source"]
            }
          ]
        },
        "metric": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "usedForCalculation": {
              "type": "boolean"
            },
            "roles": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "valueKind": {
              "type": "string",
              "enum": [
                "binary",
                "categorical",
                "continuous",
                "species-presence",
                "precomputed-json",
                "unknown"
              ]
            },
            "units": {
              "type": "string"
            }
          }
        },
        "display": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "arcgisType": {
              "type": "string",
              "enum": ["feature", "tile", "imagery-tile", "graphics"]
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "styleHint": {
              "type": "string"
            }
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sourceFilename": {
              "type": "string"
            },
            "repoPath": {
              "type": "string"
            },
            "googleSheetName": {
              "type": "string"
            },
            "notes": {
              "type": "string"
            }
          }
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["blob", "remote-service", "local-public", "pending"]
        },
        "url": {
          "type": "string"
        },
        "blobPath": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "encoding": {
          "type": "string"
        },
        "checksum": {
          "type": "string"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
