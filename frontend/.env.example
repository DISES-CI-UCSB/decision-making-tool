# Names only. Copy to `.env` or `.env.production.local` and fill in values.
# Vercel reads these at build time; Docker passes them as frontend build args.

# Firebase web client
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Optional routing / feature flags
ACCESS_REQUEST_NOTIFICATION_EMAIL=
GOOGLE_CLIENT_ID=
MANIFEST_BLOB_URL=
CATALOG_RELEASE_INDEX_BLOB_URL=
SIRAP_MANIFEST_BLOB_URL=
BLOB_ASSET_PROXY_PATH=
METRICS_API_BASE_URL=
ENABLE_MANIFEST_EDITOR=

# Frontend container: nginx proxy target for /metrics-api/ (the backend service)
METRICS_API_UPSTREAM=
