# Names only. Copy to `.env.production.local` and fill in values.
# Read at build time by `yarn build:vercel` (also set them as build variables on Vercel or in CI).

# Firebase web client
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Optional routing / feature flags
ACCESS_REQUEST_NOTIFICATION_EMAIL=
GOOGLE_CLIENT_ID=
MANIFEST_BLOB_URL=
CATALOG_RELEASE_INDEX_BLOB_URL=
SIRAP_MANIFEST_BLOB_URL=
BLOB_ASSET_PROXY_PATH=
# Full origin of the Metrics API (the backend), for example
# https://test-priorizandolanaturaleza-api.parquesnacionales.gov.co
# The backend must list this app's origin in its DMT_CORS_ORIGINS.
# Empty means the same-origin `/metrics-api` path, which only Vercel rewrites.
METRICS_API_BASE_URL=
ENABLE_MANIFEST_EDITOR=
