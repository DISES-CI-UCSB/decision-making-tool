# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# Compiled output
/dist
/tmp
/out-tsc
/bazel-out

# Node
/node_modules
npm-debug.log
yarn-error.log
firestore-debug.log
firebase-debug.log

# Yarn Berry (keep the committed release binary)
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
.history/*

# Miscellaneous
/api/dev/.secrets-probe-handler.cjs
/.angular/
.sass-cache/
/connect.lock
/coverage
/.vitest-attachments/
/development-artifacts/layer-manifest/manual-edits/
/libpeerconnection.log
testem.log
/typings
__screenshots__/
/public/data/solutions/*

# Development-only cache refreshed from the Blob layer manifest.
/public/data/layer-manifest/manifest.json
# Species secondary manifest is generated and published to Blob; the app loads it from speciesManifestUrl.
/public/data/layer-manifest/species.manifest.json
# Local preview mount for unpublished species-goals artifacts.
/public/releases/
# Development-only goals previews generated from published summary CSVs.
/public/data/metrics/goals/

# Feature test system (generated)
node_modules/
.test-cache/
.test-results/
playwright-report/
test-results/

# Key material
*_service_account_key.json
*firebase-adminsdk*.json

# System files
.DS_Store
Thumbs.db
.vercel
.env
.env*.local
