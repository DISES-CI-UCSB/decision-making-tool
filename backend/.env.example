# Names only. Copy to backend/.env on the VM if you use backend/docker-compose.yml.

DMT_ARTIFACT_DIR=/backend/runtime-artifacts
DMT_ARTIFACT_MANIFEST=/backend/runtime-artifacts/manifest.json
DMT_ARTIFACT_REQUIRED=true
DMT_MESA_COVERAGE_REQUIRED=false
DMT_EXPECTED_COVERAGE_RELEASE_ID=
DMT_EXPECTED_COVERAGE_CONTRACT_SHA256=
DMT_SOLUTION_CACHE_DIR=/backend/runtime-cache/solutions
DMT_CUSTOM_POLYGON_JOB_DB=/backend/runtime-cache/jobs.sqlite3
DMT_OPS_TOKEN=
# Extra CORS origins (comma-separated). Production/preview hosts must be listed
# explicitly, e.g. https://decision-making-tool-tau.vercel.app
DMT_CORS_ORIGINS=
# Custom-AOI caps and app-layer limiter (expensive POSTs only). 0 disables the limiter.
DMT_MAX_POLYGON_VERTICES=5000
DMT_MAX_POLYGON_AREA_KM2=2200000
DMT_RATE_LIMIT_PER_MINUTE=30
MANIFEST_BLOB_URL=https://aagibolq28slyfof.public.blob.vercel-storage.com/releases/catalog-v3-2-0/manifest.json
DMT_MANIFEST_URL=https://aagibolq28slyfof.public.blob.vercel-storage.com/releases/catalog-v3-2-0/manifest.json
BLOB_READ_WRITE_TOKEN=
