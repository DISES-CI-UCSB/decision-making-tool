# Data policy: ignore binary/large files by default, track docs + deploy assets + CSVs.
/data/**
!/data/**/
!/data/README.md
!/data/input_layers_in_use.csv
!/data/input_layers_required.csv
!/data/**/*.md
!/data/**/*.csv
# Local source rasters stay ignored by default; published layer assets move through Vercel Blob.
!/data/solutions/
!/data/solutions/**/*.tif
!/data/solutions/**/*.csv
!/data/solutions/**/*.rds
!/data/solutions/**/*.json
!/data/boundaries/
!/data/boundaries/**
/data/boundaries/SIRAPS/
!/data/**/*.py
# Frontend deploy assets (bundled into Vercel build)
!/data/frontend_deploy/
!/data/frontend_deploy/**
!/data/frontend_deploy/**/*.tif
!/data/frontend_deploy/**/*.csv
!/data/frontend_deploy/**/*.mjs
!/data/frontend_deploy/**/*.json
/frontend/node_modules/
/frontend/dist/
/frontend/.angular/
# Development-only cache refreshed from the Blob layer manifest.
/frontend/public/data/layer-manifest/manifest.json
# Development-only styled manifest drafts saved from the local editor.
/frontend/development-artifacts/layer-manifest/manual-edits/
# Species secondary manifest is generated locally and published to Blob; not tracked (app loads from speciesManifestUrl).
/frontend/public/data/layer-manifest/species.manifest.json
.vercel
.env*.local

# Generated outputs from exploratory development artifacts
/development-artifacts/experiments/**/artifacts/
/development-artifacts/experiments/**/cache/
/development-artifacts/experiments/**/results*.json

# Python generated files
__pycache__/
*.py[cod]
