# Workspace-level ignores. Each side keeps its own rules in frontend/.gitignore
# and backend/.gitignore, because those folders are published as standalone repos.

.env
.env*.local
*.local
.DS_Store
.vercel
branch-*-decision-making-tool.code-workspace

# Pre-restructure local datasets left at the workspace root (tracked data lives in backend/data)
/data/

# Key material kept next to the checkout
*_service_account_key.json
*firebase-adminsdk*.json

# Tooling caches
node_modules/
__pycache__/
*.py[cod]
.test-cache/
.test-results/
playwright-report/
test-results/
