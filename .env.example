# Names only. Copy to `.env` or `.env.production.local` and fill in values.
# Vercel still reads these at build time; Docker uses them as frontend build args
# and backend runtime env.

# Firebase web client
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Optional frontend routing / feature flags
ACCESS_REQUEST_NOTIFICATION_EMAIL=
GOOGLE_CLIENT_ID=
MANIFEST_BLOB_URL=
CATALOG_RELEASE_INDEX_BLOB_URL=
SIRAP_MANIFEST_BLOB_URL=
BLOB_ASSET_PROXY_PATH=
METRICS_API_BASE_URL=/metrics-api
ENABLE_MANIFEST_EDITOR=false

# Frontend container: nginx proxy target for /metrics-api/
METRICS_API_UPSTREAM=http://backend:8000

# Backend container
DMT_ARTIFACT_DIR=/backend/runtime-artifacts
DMT_ARTIFACT_MANIFEST=/backend/runtime-artifacts/manifest.json
DMT_ARTIFACT_REQUIRED=true
DMT_MESA_COVERAGE_REQUIRED=false
DMT_EXPECTED_COVERAGE_RELEASE_ID=
DMT_EXPECTED_COVERAGE_CONTRACT_SHA256=
DMT_SOLUTION_CACHE_DIR=/backend/runtime-cache/solutions
DMT_CUSTOM_POLYGON_JOB_DB=/backend/runtime-cache/jobs.sqlite3
DMT_OPS_TOKEN=
DMT_CORS_ORIGINS=
DMT_MANIFEST_URL=
